# ---- Network ----
LAB_NETWORK_SUBNET=172.28.0.0/24

# ---- Classical TLS server ----
TLS_CLASSICAL_IMAGE=nginx:1.27-alpine
TLS_CLASSICAL_PORT=8443
TLS_CLASSICAL_CERT_DAYS=365

# ---- PQC TLS server (placeholder / configurable) ----
# Leave as a plain OpenSSL-based image until you have a PQC-capable build
# (e.g. an oqs-provider / liboqs-enabled OpenSSL or nginx image).
PQC_BASE_IMAGE=nginx:1.27-alpine
PQC_TLS_PORT=8444
PQC_ENABLED=false
PQC_GROUPS=X25519MLKEM768
PQC_ALLOW_CLASSICAL_FALLBACK=true

# ---- Capture ----
CAPTURE_ROTATE_SECONDS=300
CAPTURE_SNAPLEN=262144

# ---- Zeek ----
ZEEK_IMAGE=zeek/zeek:6.2

# ---- Telemetry ----
TELEMETRY_IMAGE_PYTHON=python:3.11-slim
TELEMETRY_INTERVAL_SECONDS=5